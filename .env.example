# 钉钉账号配置（复制本文件为 .env 并填入真实值）
DINGTALK_MOBILE=13800138000
DINGTALK_PASSWORD=your_password_here

# 打卡时间配置（cron 表达式）
# 上班打卡：周一至周五 09:00
CHECKIN_CRON=0 9 * * 1-5
# 下班打卡：周一至周五 18:00
CHECKOUT_CRON=0 18 * * 1-5

# 打卡位置（模拟 GPS 坐标，需与公司位置一致）
LOCATION_LATITUDE=39.9042
LOCATION_LONGITUDE=116.4074
LOCATION_ADDRESS=北京市东城区某某大厦

# 随机延迟范围（秒），模拟人工操作，避免每天精确同一时刻
RANDOM_DELAY_MIN=0
RANDOM_DELAY_MAX=300

# 通知配置（可选，打卡结果推送到微信）
# 使用 Server 酱：https://sct.ftqq.com/
SERVERCHAN_KEY=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
