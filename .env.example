# =============================================================
# 钉钉辅助打卡配置文件
# 复制本文件为 .env 并填入真实值（.env 已加入 .gitignore，不会提交）
# =============================================================

# ------------------------------------------------------------------
# 运行模式：
#   app  → 手机 APP 自动化打卡（推荐，适用于任何打卡 APP）
#   web  → 钉钉 Web 接口打卡（仅限钉钉，需抓 Cookie）
# ------------------------------------------------------------------
MODE=app

# ================================================================
# ① APP 自动化模式配置（MODE=app 时生效）
# ================================================================

# 目标平台：android 或 ios
APP_PLATFORM=android

# ------------------------------------------------------------------
# Android 配置
# ------------------------------------------------------------------
# 设备 serial（只有一台设备连接时留空自动检测）
# 多设备时通过 adb devices 查看 serial，填入此处
DEVICE_SERIAL=

# 打卡 APP 的包名（必填）
# 获取方法：打开目标 APP → 执行 adb shell dumpsys window | grep mCurrentFocus
# 示例输出：mCurrentFocus=Window{... com.example.checkin/com.example.MainActivity}
# 则 APP_PACKAGE=com.example.checkin
APP_PACKAGE=com.example.checkin

# 目标 Activity（可选，留空则自动启动默认 Activity）
# 从上面命令输出的斜杠后半部分获取
APP_ACTIVITY=

# ------------------------------------------------------------------
# iOS 配置
# ------------------------------------------------------------------
# APP Bundle ID（iOS 必填）
# 获取方法：tidevice applist | grep 打卡APP名字
APP_BUNDLE_ID=

# WDA 服务地址（默认即可，如修改了端口则对应修改）
WDA_URL=http://127.0.0.1:8100

# ------------------------------------------------------------------
# 打卡按钮定位（三选一，优先级：resource_id > text > xpath）
# ------------------------------------------------------------------
# 方式 1：Android resource-id（最稳定，推荐优先使用）
# 获取方法：运行 python tools/inspect_app.py 截图后用 uiautomatorviewer 查看
APP_CHECKIN_RESOURCE_ID=

# 方式 2：按钮上的文字（最简单，适合文字明确的按钮）
APP_CHECKIN_TEXT=打卡

# 方式 3：XPath 表达式（布局复杂时使用）
APP_CHECKIN_XPATH=

# 打卡成功后页面显示的文字（用于验证打卡结果，留空则不验证）
# 例如："打卡成功"、"签到成功"、"已打卡"
APP_SUCCESS_TEXT=打卡成功

# 需要自动关闭的弹窗按钮文字（逗号分隔）
# 常见：我知道了、跳过、关闭、以后再说
APP_POPUP_DISMISS=我知道了,跳过,关闭,以后再说

# 查找元素最大等待秒数
APP_ELEMENT_TIMEOUT=10

# APP 启动后等待页面加载的秒数
APP_LAUNCH_WAIT=3

# 打卡完成后是否按 Home 键回到桌面（true/false）
APP_GO_HOME=true

# ================================================================
# ② Web 接口模式配置（MODE=web 时生效，仅限钉钉）
# ================================================================
# 获取步骤：Chrome 打开 attend.dingtalk.com 登录 → F12 → Application → Cookies
DINGTALK_TOKEN=
DINGTALK_USER_ID=
DINGTALK_COOKIE=

# 打卡位置 GPS 坐标
LOCATION_LATITUDE=39.9042
LOCATION_LONGITUDE=116.4074
LOCATION_ADDRESS=北京市东城区某某大厦

# ================================================================
# 定时调度（cron 表达式：分 时 日 月 周）
# ================================================================
# 周一至周五 09:00 上班打卡
CHECKIN_CRON=0 9 * * 1-5
# 周一至周五 18:00 下班打卡
CHECKOUT_CRON=0 18 * * 1-5

# 打卡前随机延迟（秒），模拟人工波动，建议设 0~300
RANDOM_DELAY_MIN=0
RANDOM_DELAY_MAX=300

# ================================================================
# 通知 & 日志
# ================================================================
# Server 酱微信推送（可选）：https://sct.ftqq.com/
SERVERCHAN_KEY=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
