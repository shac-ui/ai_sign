# =============================================================
# 钉钉辅助打卡配置文件
# 复制本文件为 .env 并填入真实值（.env 已加入 .gitignore，不会提交）
# =============================================================

# ------------------------------------------------------------------
# 钉钉认证信息（Cookie 方式）
# ------------------------------------------------------------------
# 获取步骤：
#   1. 用 Chrome 打开 https://attend.dingtalk.com 并扫码/账号登录
#   2. 按 F12 打开开发者工具 → Application → Cookies → attend.dingtalk.com
#   3. 复制 "dingtalk_token" 字段的值粘贴到下方
#
# 注意：Cookie 有效期约 7 天，过期需重新获取
DINGTALK_TOKEN=your_dingtalk_token_here

# 你的钉钉员工 userId
# 获取方式：同上开发者工具 Cookies 中找 "empid" 字段，
# 或在任意打卡接口的请求/响应 JSON 中找 "userId" 字段
DINGTALK_USER_ID=your_user_id_here

# （可选）如需携带更多 Cookie 字段，将完整 Cookie 字符串粘贴到此处
# 例如：dingtalk_token=xxx; emp_id=yyy; ...
# 填写后将覆盖上方 DINGTALK_TOKEN 单独设置
DINGTALK_COOKIE=

# ------------------------------------------------------------------
# 打卡时间配置（cron 表达式：分 时 日 月 周）
# ------------------------------------------------------------------
# 周一至周五 09:00 上班打卡
CHECKIN_CRON=0 9 * * 1-5
# 周一至周五 18:00 下班打卡
CHECKOUT_CRON=0 18 * * 1-5

# ------------------------------------------------------------------
# 打卡位置（GPS 坐标，必须在公司考勤范围内）
# ------------------------------------------------------------------
# 在手机地图 App 长按公司位置可获取精确坐标
LOCATION_LATITUDE=39.9042
LOCATION_LONGITUDE=116.4074
LOCATION_ADDRESS=北京市东城区某某大厦

# ------------------------------------------------------------------
# 随机延迟（秒），模拟人工操作波动，0~300 表示随机等待 0 到 5 分钟
# ------------------------------------------------------------------
RANDOM_DELAY_MIN=0
RANDOM_DELAY_MAX=300

# ------------------------------------------------------------------
# 可选：Server 酱微信推送打卡结果
# 申请地址：https://sct.ftqq.com/
# ------------------------------------------------------------------
SERVERCHAN_KEY=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
